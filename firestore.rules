rules_version = '2';

// Server-side guard for Trump Jump save/leaderboard docs. These run on
// Google's servers and CANNOT be bypassed from the browser (F12, forged SDK
// calls, tampered client all still hit these checks).
//
// Two layers protect the leaderboard:
//   1. src/systems/runguard.js  — client side. Altitude is tracked in a private
//      closure and rate-checked against the game's own physics, and the score
//      is submitted as a single-use signed ticket. Stops console edits.
//   2. this file — server side. Even a player who ignores the client entirely
//      and writes to their own doc with the public SDK can only move `best`
//      forward, within a ceiling, and no faster than the game could produce it.
//
// Scope of protection (intentional, for a casual game):
//   - a user can only read/write sanely-shaped data in their OWN doc
//   - no other user's doc can be written
//   - absurd one-shot values (bank = 999999999, best = 999999) are rejected
//   - a doc cannot be CREATED carrying a score, so a fresh account can't be
//     minted straight onto the top of the leaderboard
//   - `best` and `bank` can only climb as fast as real play allows, measured
//     against the server clock — grinding a forged score now costs real time
//   - NO personal data (email) is stored here, so the public leaderboard read
//     cannot leak PII
// NOT protected (accepted residual risk; would need Cloud Functions to close):
//   - a patient attacker drip-feeding writes at the allowed rate
//   - a user forging their OWN cosmetic items *within* these caps. This only
//     affects their own account, never other players.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {

      // ---- believable ceilings (tune to your real game) --------------
      function maxBank() { return 10000000; }  // 10M lifetime coin cap
      function maxBest() { return 50000;    }  // plausible top score ceiling

      // Fastest the game can physically climb: the jet cruise is 850 px/s at
      // the 1.4x max pace ramp, and 10 px = 1 m. Keep in step with MAX_M_PER_S
      // in src/systems/runguard.js.
      function maxClimbPerSec() { return 130; }
      // one-run allowance, so a single legitimate game-over write always fits
      // even when it lands right after the previous save
      function bestBurst() { return 300; }
      // coins are earned far slower than metres, but a run also banks a
      // distance bonus; these two together cover any single honest run
      function maxCoinsPerSec() { return 50; }
      function coinBurst() { return 2500; }

      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      function d()       { return request.resource.data; }
      function hasDoc() { return resource != null; }
      function oldBest() { return hasDoc() ? resource.data.get('best', 0) : 0; }
      function oldBank() { return hasDoc() ? resource.data.get('bank', 0) : 0; }

      // Seconds of server time since this doc was last written. Every write
      // stamps updatedAt with serverTimestamp(), so this cannot be faked from
      // the client. Falls back to a day for docs written before the stamp
      // existed — a first write is never the attack we're pricing out.
      function lastWrite() {
        return (hasDoc() && 'updatedAt' in resource.data
                && resource.data.updatedAt is timestamp)
               ? resource.data.updatedAt : null;
      }
      function elapsedSec() {
        return lastWrite() == null ? 86400
             : (request.time.toMillis() - lastWrite().toMillis()) / 1000;
      }

      // only these keys may exist on the doc. NOTE: 'email' is deliberately
      // absent — storing it here + public read = PII leak. Do not re-add it.
      function fieldsOk() {
        return d().keys().hasOnly([
          'bank','bills','boosts','best','bestUid','maps','ships','skins','up',
          'ship','map','skin','pfp','boostSide','username','usernameLower','updatedAt'
        ]);
      }

      // wallet: whole number, 0..cap, and it may only grow as fast as a run can
      // actually earn. Spending (a drop) is always fine.
      function bankOk() {
        let b = d().get('bank', 0);
        return b is int && b >= 0 && b <= maxBank()
            && (b <= oldBank()
                || b - oldBank() <= coinBurst() + maxCoinsPerSec() * elapsedSec());
      }

      // high score: whole number, 0..cap, can only ever rise, may not appear on
      // a brand-new doc, and cannot jump further than the run had time to climb
      function bestOk() {
        let s = d().get('best', 0);
        return s is int && s >= 0 && s <= maxBest()
            && s >= oldBest()
            && (hasDoc() || s == 0)
            && (s == oldBest()
                || s - oldBest() <= bestBurst() + maxClimbPerSec() * elapsedSec());
      }

      // every write must stamp the clock the rate checks above depend on
      function stampOk() {
        return 'updatedAt' in d() && d().updatedAt == request.time;
      }

      // light type guards so one field can't be smuggled in as another
      function typesOk() {
        return d().get('maps',  []).size() >= 0
            && d().get('ships', []).size() >= 0
            && d().get('skins', []).size() >= 0
            && d().get('bills', 0) is int && d().get('bills', 0) >= 0
            && d().get('boosts', 0) is int && d().get('boosts', 0) >= 0
            && (!('username' in d()) || (d().username is string && d().username.size() <= 16))
            && (!('usernameLower' in d()) || (d().usernameLower is string && d().usernameLower.size() <= 16))
            && (!('boostSide' in d()) || d().boostSide is string)
            && (!('pfp' in d()) || d().pfp is string);
      }

      allow read: if true;                       // leaderboard is public (no PII stored)
      allow create, update: if isOwner()
                            && fieldsOk()
                            && stampOk()
                            && bankOk()
                            && bestOk()
                            && typesOk();
      allow delete: if false;
    }
  }
}
